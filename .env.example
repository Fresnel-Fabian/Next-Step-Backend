# .env.example — copy to .env and fill in. NEVER commit .env.

# --- App ---
APP_NAME="Next Step API"
DEBUG=true                          # true only for local dev
ENVIRONMENT=development             # development | staging | production

# --- Database (Postgres) ---
# Format: postgresql+asyncpg://user:password@host:port/db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/school_db

# --- Redis (Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API.
# Local dev defaults below; production must include the deployed frontend URL(s).
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006

# --- Google OAuth ---
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list of accepted client IDs (web, iOS, Android).
GOOGLE_CLIENT_IDS=

# --- Email (Gmail SMTP) ---
MAIL_USERNAME=
MAIL_PASSWORD=                      # Gmail App Password, not the account password
MAIL_FROM=
MAIL_FROM_NAME="Next Step"
FRONTEND_URL=http://localhost:8081

# --- Sentry (error tracking) ---
# Leave empty to disable. Get DSN from sentry.io project settings.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
